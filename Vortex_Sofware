  <style>
    /* ==================== ESTILOS BASE Y TEMA OSCURO TECNOLÓGICO ==================== */
    body {
      background-color: #0B1120;
      color: #F8FAFC;
      overflow-x: hidden;
    }

    /* Cuadrícula arquitectónica sutil para fondos interiores */
    .tech-grid {
      background-image:
        linear-gradient(to right, rgba(6, 182, 212, 0.045) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.035) 1px, transparent 1px);
      background-size: 48px 48px;
    }

    /* Tarjetas Glassmorphism con capas decorativas no bloqueantes */
    .glass-panel {
      position: relative;
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.82), rgba(11, 17, 32, 0.92));
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(6, 182, 212, 0.18);
      box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.65);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-panel::before,
    .glass-panel::after {
      pointer-events: none;
    }

    .glass-panel:hover {
      border-color: rgba(6, 182, 212, 0.48);
      box-shadow: 0 18px 42px -12px rgba(6, 182, 212, 0.24), 0 0 22px -6px rgba(16, 185, 129, 0.20);
      transform: translateY(-3px);
    }

    /* Gradiente de texto Cian Eléctrico -> Verde Esmeralda */
    .text-gradient-vortex {
      background: linear-gradient(135deg, #F8FAFC 10%, #22D3EE 55%, #10B981 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Botón CTA principal con degradado cian/esmeralda */
    .btn-vortex-primary {
      background: linear-gradient(135deg, #06B6D4 0%, #10B981 100%);
      box-shadow: 0 0 26px rgba(6, 182, 212, 0.35);
      transition: all 0.25s ease;
    }

    .btn-vortex-primary:hover {
      background: linear-gradient(135deg, #22D3EE 0%, #34D399 100%);
      box-shadow: 0 0 36px rgba(6, 182, 212, 0.55), 0 0 18px rgba(16, 185, 129, 0.35);
      transform: translateY(-1.5px);
    }

    /* Garantía crítica de interactividad para botones y enlaces de redes sociales */
    .social-link-btn {
      position: relative;
      z-index: 20;
      pointer-events: auto !important;
      cursor: pointer !important;
      touch-action: manipulation;
    }

    /* Todos los elementos decorativos y canvas jamás interceptan clics */
    .decorative-overlay,
