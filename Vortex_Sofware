  <!-- ==================== BANNER DE RESPALDO PARA ENTORNO SANDBOX ==================== -->
  <!-- Se muestra automáticamente solo si el navegador/iframe bloquea ventanas emergentes externas -->
  <div id="sandbox-link-banner" class="hidden fixed bottom-5 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 rounded-2xl bg-[#0F172A]/95 backdrop-blur-2xl border border-cyan-400/50 shadow-2xl shadow-cyan-500/20 p-5 space-y-3.5">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shrink-0 animate-pulse"></span>
        <h4 id="sandbox-banner-title" class="font-display font-bold text-sm text-white">
          Enlace oficial de Vortex Software
        </h4>
      </div>
      <button type="button" id="close-sandbox-banner" class="text-slate-400 hover:text-white text-sm font-bold px-1.5 cursor-pointer" aria-label="Cerrar notificación">✕</button>
    </div>

    <p class="text-xs text-slate-300 leading-relaxed">
      La vista previa restringe la apertura automática de pestañas externas. Puedes abrir el perfil directamente o copiar la dirección:
    </p>

    <div class="px-3 py-2 rounded-xl bg-[#0B1120] border border-slate-800 text-xs font-mono text-cyan-300 truncate select-all" id="sandbox-banner-url">
      https://...
    </div>

    <div class="flex items-center gap-2.5 pt-1">
      <a id="sandbox-direct-open" href="#" target="_top" rel="noopener noreferrer" class="flex-1 py-2.5 px-4 rounded-xl text-xs font-bold text-slate-950 btn-vortex-primary text-center cursor-pointer">
        Abrir perfil ahora
      </a>
      <button type="button" id="sandbox-copy-url-btn" class="py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-cyan-500/35 text-xs font-semibold text-cyan-300 transition-colors cursor-pointer">
        Copiar URL
      </button>
    </div>
  </div>

  <!-- ==================== SCRIPTS DE INTERACTIVIDAD ==================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // ------------------------------------------------------------------
      // 1. NAVEGACIÓN SUAVE EXCLUSIVA PARA ANCLAS INTERNAS (#)
      // ------------------------------------------------------------------
      // Garantiza que JAMÁS se ejecute e.preventDefault() en enlaces http/https
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const targetId = anchor.getAttribute('href');
          if (targetId && targetId.length > 1) {
            const targetElement = document.querySelector(targetId);
            if (targetElement) {
              e.preventDefault();
              targetElement.scrollIntoView({ behavior: 'smooth' });
            }
          }
        });
      });

      // ------------------------------------------------------------------
      // 2. MANEJO INTELIGENTE DE ENLACES EXTERNOS DE REDES SOCIALES
      // ------------------------------------------------------------------
      const socialLinks = document.querySelectorAll('a.social-link-btn');
      const sandboxBanner = document.getElementById('sandbox-link-banner');
      const sandboxBannerTitle = document.getElementById('sandbox-banner-title');
      const sandboxBannerUrl = document.getElementById('sandbox-banner-url');
      const sandboxDirectOpen = document.getElementById('sandbox-direct-open');
      const sandboxCopyBtn = document.getElementById('sandbox-copy-url-btn');
      const closeSandboxBannerBtn = document.getElementById('close-sandbox-banner');

      function showSandboxFallback(networkName, url) {
        sandboxBannerTitle.textContent = `Perfil oficial en ${networkName}`;
        sandboxBannerUrl.textContent = url;
        sandboxDirectOpen.setAttribute('href', url);
        sandboxCopyBtn.textContent = 'Copiar URL';
        sandboxCopyBtn.classList.remove('border-emerald-400', 'text-emerald-300');
        sandboxBanner.classList.remove('hidden');
      }

      socialLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          // Permitir comportamiento nativo en clics con teclas modificadoras (Ctrl/Cmd/Shift)
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) {
            return;
          }

          const url = link.getAttribute('href');
          const networkName = link.getAttribute('data-social-name') || 'Red Social';

          if (!url || !url.startsWith('http')) return;

          // Intentar abrir en nueva pestaña; si el sandbox del navegador lo bloquea, activar respaldo visual
          let newTab = null;
          try {
            newTab = window.open(url, '_blank');
            if (newTab) {
              try {
                newTab.opener = null;
              } catch (_) {}
            }
          } catch (_) {
            newTab = null;
          }

          if (newTab) {
            // La pestaña se abrió con éxito en el navegador; evitamos abrir una segunda pestaña duplicada
            e.preventDefault();
          } else {
            // El entorno sandbox bloqueó window.open: evitamos navegación rota y mostramos la tarjeta con la URL lista
            e.preventDefault();
            showSandboxFallback(networkName, url);
          }
        });
      });

      closeSandboxBannerBtn.addEventListener('click', () => {
        sandboxBanner.classList.add('hidden');
      });

      sandboxCopyBtn.addEventListener('click', () => {
        const urlToCopy = sandboxBannerUrl.textContent.trim();
        const tempInput = document.createElement('input');
        tempInput.value = urlToCopy;
        document.body.appendChild(tempInput);
        tempInput.select();
        try {
          document.execCommand('copy');
          sandboxCopyBtn.textContent = '¡URL copiada!';
          sandboxCopyBtn.classList.add('border-emerald-400', 'text-emerald-300');
        } catch (err) {
          console.error('Error al copiar enlace:', err);
        }
        document.body.removeChild(tempInput);
      });

      // ------------------------------------------------------------------
      // 3. MENÚ HAMBURGUESA MÓVIL RESPONSIVO
      // ------------------------------------------------------------------
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('icon-hamburger');
      const iconClose = document.getElementById('icon-close');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function setMobileMenu(open) {
        if (open) {
          mobileMenu.classList.remove('hidden');
          iconHamburger.classList.add('hidden');
          iconClose.classList.remove('hidden');
          mobileMenuBtn.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu.classList.add('hidden');
          iconHamburger.classList.remove('hidden');
          iconClose.classList.add('hidden');
          mobileMenuBtn.setAttribute('aria-expanded', 'false');
        }
      }

      mobileMenuBtn.addEventListener('click', () => {
        const isHidden = mobileMenu.classList.contains('hidden');
        setMobileMenu(isHidden);
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => setMobileMenu(false));
      });

      // ------------------------------------------------------------------
      // 4. ANIMACIONES DE APARICIÓN EN SCROLL (IntersectionObserver)
      // ------------------------------------------------------------------
      const revealEls = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      revealEls.forEach((el) => observer.observe(el));

      // ------------------------------------------------------------------
      // 5. HERO CANVAS INTERACTIVO: VÓRTICE DE PARTÍCULAS Y LÍNEAS GEOMÉTRICAS
      // ------------------------------------------------------------------
      const heroSection = document.getElementById('inicio');
      const canvas = document.getElementById('vortexHeroCanvas');
      const ctx = canvas.getContext('2d');

      let cw = 0;
      let ch = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let pointerActive = false;
      let pointerX = 0;
      let pointerY = 0;
      let speedFactor = 1;
      let boostTimer = 0;
      let elapsed = 0;

      const particles = [];
      const TOTAL_PARTICLES = 150;

      function createParticles() {
        particles.length = 0;
        for (let i = 0; i < TOTAL_PARTICLES; i++) {
          const depthRatio = Math.random();
          particles.push({
            angle: Math.random() * Math.PI * 2,
            depthRatio: depthRatio,
            baseSpeed: 0.008 + (1 - depthRatio) * 0.012 + Math.random() * 0.008,
            radius: 1.5 + (1 - depthRatio) * 2.3,
            alpha: 0.35 + Math.random() * 0.65,
            isEmerald: Math.random() > 0.72
          });
        }
      }

      function resizeHeroCanvas() {
        const rect = heroSection.getBoundingClientRect();
        cw = rect.width;
        ch = rect.height;
        canvas.width = cw * dpr;
        canvas.height = ch * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (!pointerActive) {
          pointerX = cw / 2;
          pointerY = ch / 2;
        }
      }

      function triggerInteraction(x, y) {
        pointerActive = true;
        pointerX = x;
        pointerY = y;
        boostTimer = 45;
      }

      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        triggerInteraction(e.clientX - rect.left, e.clientY - rect.top);
      });

      heroSection.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          const rect = heroSection.getBoundingClientRect();
          triggerInteraction(e.touches[0].clientX - rect.left, e.touches[0].clientY - rect.top);
        }
      }, { passive: true });

      heroSection.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          const rect = heroSection.getBoundingClientRect();
          triggerInteraction(e.touches[0].clientX - rect.left, e.touches[0].clientY - rect.top);
        }
      }, { passive: true });

      function animateVortex() {
        ctx.clearRect(0, 0, cw, ch);

        if (boostTimer > 0) {
          boostTimer--;
        } else {
          pointerActive = false;
        }

        const targetSpeed = pointerActive ? 2.75 : 1.0;
        speedFactor += (targetSpeed - speedFactor) * 0.06;
        elapsed += 0.016 * speedFactor;

        const offsetX = pointerActive ? (pointerX - cw / 2) * 0.08 : 0;
        const offsetY = pointerActive ? (pointerY - ch / 2) * 0.08 : 0;

        const centerX = cw / 2 + offsetX;
        const centerY = ch * 0.48 + offsetY;
        const maxRadiusX = Math.min(cw * 0.46, 540);
        const maxRadiusY = Math.min(ch * 0.34, 320);

        // Resplandor radial ambiental
        const bgGlow = ctx.createRadialGradient(centerX, centerY, 20, centerX, centerY, maxRadiusX * 1.15);
        bgGlow.addColorStop(0, 'rgba(6, 182, 212, 0.20)');
        bgGlow.addColorStop(0.5, 'rgba(16, 185, 129, 0.07)');
        bgGlow.addColorStop(1, 'rgba(11, 17, 32, 0)');
        ctx.fillStyle = bgGlow;
        ctx.fillRect(0, 0, cw, ch);

        // Polígonos geométricos rotatorios
        for (let g = 0; g < 2; g++) {
          ctx.save();
          ctx.translate(centerX, centerY);
          ctx.rotate(elapsed * (g === 0 ? 0.12 : -0.09));
          ctx.strokeStyle = g === 0 ? 'rgba(6, 182, 212, 0.14)' : 'rgba(16, 185, 129, 0.11)';
          ctx.lineWidth = 1.1;
          const polyR = maxRadiusX * (g === 0 ? 0.85 : 0.62);
          ctx.beginPath();
          for (let s = 0; s < 6; s++) {
            const theta = (s * Math.PI) / 3;
            const px = Math.cos(theta) * polyR;
            const py = Math.sin(theta) * (polyR * 0.65);
            if (s === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.closePath();
          ctx.stroke();
          ctx.restore();
        }

        // Anillos orbitales
        const rings = 6;
        for (let r = 0; r < rings; r++) {
          const t = r / (rings - 1);
          const rx = maxRadiusX * (0.22 + t * 0.78);
          const ry = maxRadiusY * (0.22 + t * 0.78);
          ctx.beginPath();
          ctx.ellipse(centerX, centerY, rx, ry, Math.sin(elapsed * 0.5 + r) * 0.06, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(34, 211, 238, ${0.18 - t * 0.10})`;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }

        // Partículas luminosas y estelas
        const screenNodes = [];

        particles.forEach((p) => {
          p.angle += p.baseSpeed * speedFactor;
          p.depthRatio += 0.0014 * speedFactor;
          if (p.depthRatio > 1) p.depthRatio = 0;

          const scale = 1 - p.depthRatio * 0.78;
          const rx = maxRadiusX * scale;
          const ry = maxRadiusY * scale;

          const x = centerX + Math.cos(p.angle) * rx;
          const y = centerY + Math.sin(p.angle) * ry;

          screenNodes.push({ x, y, isEmerald: p.isEmerald });

          const trailAngle = p.angle - p.baseSpeed * (2.5 + speedFactor * 1.4);
          const tx = centerX + Math.cos(trailAngle) * rx;
          const ty = centerY + Math.sin(trailAngle) * ry;

          ctx.beginPath();
          ctx.moveTo(tx, ty);
          ctx.lineTo(x, y);
          ctx.strokeStyle = p.isEmerald
            ? `rgba(52, 211, 153, ${p.alpha * 0.65})`
            : `rgba(34, 211, 238, ${p.alpha * 0.75})`;
          ctx.lineWidth = p.radius * 0.85;
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(x, y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = p.isEmerald ? '#34D399' : '#22D3EE';
          ctx.fill();
        });

        // Líneas de conexión entre nodos cercanos
        ctx.lineWidth = 0.75;
        for (let i = 0; i < screenNodes.length; i += 2) {
          for (let j = i + 1; j < screenNodes.length; j += 3) {
            const dx = screenNodes[i].x - screenNodes[j].x;
            const dy = screenNodes[i].y - screenNodes[j].y;
            const dist = Math.hypot(dx, dy);
            if (dist < 78) {
              const opacity = (1 - dist / 78) * 0.30;
              ctx.beginPath();
              ctx.moveTo(screenNodes[i].x, screenNodes[i].y);
              ctx.lineTo(screenNodes[j].x, screenNodes[j].y);
              ctx.strokeStyle = screenNodes[i].isEmerald
                ? `rgba(16, 185, 129, ${opacity})`
                : `rgba(6, 182, 212, ${opacity})`;
              ctx.stroke();
            }
          }
        }

        requestAnimationFrame(animateVortex);
      }

      createParticles();
      resizeHeroCanvas();
      window.addEventListener('resize', resizeHeroCanvas);
      animateVortex();

      // ------------------------------------------------------------------
      // 6. COTIZADOR DINÁMICO DE APLICACIONES
      // ------------------------------------------------------------------
      const baseCards = document.querySelectorAll('.base-type-card');
      const moduleCheckboxes = document.querySelectorAll('.module-checkbox');
      const quoteBaseTitle = document.getElementById('quote-base-title');
      const quoteTotalWeeks = document.getElementById('quote-total-weeks');
      const quoteTotalPrice = document.getElementById('quote-total-price');
      const quoteSelectedTags = document.getElementById('quote-selected-tags');
      const transferQuoteBtn = document.getElementById('transfer-quote-btn');

      let currentBase = {
        name: 'App Móvil',
        price: 18000,
        weeks: 3
      };

      function refreshModuleCardStyles() {
        moduleCheckboxes.forEach((cb) => {
          const card = cb.closest('.module-card');
          const badge = card.querySelector('.custom-check');
          if (cb.checked) {
            card.classList.remove('border-slate-800', 'bg-slate-900/75');
            card.classList.add('border-cyan-400/70', 'bg-cyan-500/12');
            badge.classList.remove('border-slate-600', 'text-transparent');
            badge.classList.add('bg-emerald-400', 'border-emerald-400', 'text-slate-950');
          } else {
            card.classList.add('border-slate-800', 'bg-slate-900/75');
            card.classList.remove('border-cyan-400/70', 'bg-cyan-500/12');
            badge.classList.add('border-slate-600', 'text-transparent');
            badge.classList.remove('bg-emerald-400', 'border-emerald-400', 'text-slate-950');
          }
        });
      }

      function calculateQuote() {
        let totalWeeks = currentBase.weeks;
        let totalPrice = currentBase.price;
        const selectedModules = [];

        moduleCheckboxes.forEach((cb) => {
          if (cb.checked) {
            totalWeeks += parseFloat(cb.dataset.weeks);
            totalPrice += parseInt(cb.dataset.price, 10);
            selectedModules.push(cb.dataset.label);
          }
        });

        const formattedWeeks = Number.isInteger(totalWeeks) ? totalWeeks : totalWeeks.toFixed(1);
        const formattedPrice = totalPrice.toLocaleString('es-MX');

        quoteBaseTitle.textContent = currentBase.name;
        quoteTotalWeeks.textContent = `${formattedWeeks} semanas`;
        quoteTotalPrice.innerHTML = `$${formattedPrice} <span class="text-xs font-normal text-slate-400">MXN</span>`;

        quoteSelectedTags.innerHTML = '';
        const basePill = document.createElement('span');
        basePill.className = 'px-2.5 py-1 rounded-lg bg-emerald-500/15 border border-emerald-400/35 text-emerald-300 text-xs font-semibold';
        basePill.textContent = `Base: ${currentBase.name}`;
        quoteSelectedTags.appendChild(basePill);

        selectedModules.forEach((mod) => {
          const pill = document.createElement('span');
          pill.className = 'px-2.5 py-1 rounded-lg bg-cyan-500/15 border border-cyan-400/30 text-cyan-200 text-xs font-medium';
          pill.textContent = mod;
          quoteSelectedTags.appendChild(pill);
        });

        return {
          baseName: currentBase.name,
          weeks: formattedWeeks,
          price: formattedPrice,
          modules: selectedModules
        };
      }

      baseCards.forEach((card) => {
        card.addEventListener('click', () => {
          baseCards.forEach((c) => {
            c.classList.remove('active-base', 'bg-cyan-500/15', 'border-cyan-400', 'shadow-lg', 'shadow-cyan-500/10');
            c.classList.add('bg-slate-900/75', 'border-slate-800');
            c.querySelector('span:first-child').classList.replace('text-cyan-300', 'text-slate-400');
            const dot = c.querySelector('.radio-indicator');
            dot.classList.remove('bg-cyan-400', 'ring-4', 'ring-cyan-400/20');
            dot.classList.add('bg-slate-700');
          });

          card.classList.add('active-base', 'bg-cyan-500/15', 'border-cyan-400', 'shadow-lg', 'shadow-cyan-500/10');
          card.classList.remove('bg-slate-900/75', 'border-slate-800');
          card.querySelector('span:first-child').classList.replace('text-slate-400', 'text-cyan-300');
          const activeDot = card.querySelector('.radio-indicator');
          activeDot.classList.remove('bg-slate-700');
          activeDot.classList.add('bg-cyan-400', 'ring-4', 'ring-cyan-400/20');

          currentBase = {
            name: card.dataset.name,
            price: parseInt(card.dataset.price, 10),
            weeks: parseFloat(card.dataset.weeks)
          };

          calculateQuote();
        });
      });

      moduleCheckboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          refreshModuleCardStyles();
          calculateQuote();
        });
      });

      window.quickSelectProject = function (name) {
        const target = Array.from(baseCards).find((c) => c.dataset.name === name);
        if (target) target.click();
        document.getElementById('cotizador').scrollIntoView({ behavior: 'smooth' });
      };

      transferQuoteBtn.addEventListener('click', () => {
        const summary = calculateQuote();
        const projectSelect = document.getElementById('input-project-type');
        const messageField = document.getElementById('input-message');
        const alertBanner = document.getElementById('transferred-quote-alert');

        projectSelect.value = summary.baseName;

        const modListText = summary.modules.length > 0
          ? summary.modules.map((m) => `  - ${m}`).join('\n')
          : '  - Configuración base estándar';

        messageField.value = `Hola equipo de Vortex Software,\n\nSolicito información para desarrollar el siguiente proyecto estimado en su cotizador:\n• Proyecto base: ${summary.baseName}\n• Módulos adicionales:\n${modListText}\n• Tiempo total estimado: ${summary.weeks} semanas\n• Inversión estimada: $${summary.price} MXN\n\nQuedo atento a su respuesta.`;

        document.getElementById('contact-success-box').classList.add('hidden');
        document.getElementById('vortex-contact-form').classList.remove('hidden');
        alertBanner.classList.remove('hidden');

        document.getElementById('contacto').scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => {
          document.getElementById('input-name').focus();
        }, 600);
      });

      refreshModuleCardStyles();
      calculateQuote();

      // ------------------------------------------------------------------
      // 7. COPIAR CORREO CORPORATIVO AL PORTAPAPELES
      // ------------------------------------------------------------------
      const copyBtn = document.getElementById('copy-email-btn');
      const copyToast = document.getElementById('copy-toast');

      copyBtn.addEventListener('click', () => {
        const emailValue = document.getElementById('corporate-email-text').textContent.trim();
        const helperInput = document.createElement('input');
        helperInput.value = emailValue;
        document.body.appendChild(helperInput);
        helperInput.select();

        try {
          document.execCommand('copy');
          copyBtn.textContent = '¡Copiado!';
          copyBtn.classList.add('bg-emerald-500/20', 'border-emerald-400', 'text-emerald-300');
          copyToast.classList.remove('hidden');
          copyToast.classList.add('flex');

          setTimeout(() => {
            copyBtn.textContent = 'Copiar';
            copyBtn.classList.remove('bg-emerald-500/20', 'border-emerald-400', 'text-emerald-300');
            copyToast.classList.add('hidden');
            copyToast.classList.remove('flex');
          }, 2500);
        } catch (err) {
          console.error('No se pudo copiar el correo:', err);
        }

        document.body.removeChild(helperInput);
      });

      // ------------------------------------------------------------------
      // 8. VALIDACIÓN Y ENVÍO DEL FORMULARIO DE CONTACTO
      // ------------------------------------------------------------------
      const form = document.getElementById('vortex-contact-form');
      const successBox = document.getElementById('contact-success-box');
      const sendAnotherBtn = document.getElementById('send-another-btn');

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameEl = document.getElementById('input-name');
        const emailEl = document.getElementById('input-email');
        const msgEl = document.getElementById('input-message');

        const errName = document.getElementById('err-name');
        const errEmail = document.getElementById('err-email');
        const errMsg = document.getElementById('err-message');

        let valid = true;

        if (!nameEl.value.trim()) {
          errName.classList.remove('hidden');
          nameEl.classList.add('border-rose-500');
          valid = false;
        } else {
          errName.classList.add('hidden');
          nameEl.classList.remove('border-rose-500');
        }

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(emailEl.value.trim())) {
          errEmail.classList.remove('hidden');
          emailEl.classList.add('border-rose-500');
          valid = false;
        } else {
          errEmail.classList.add('hidden');
          emailEl.classList.remove('border-rose-500');
        }

        if (!msgEl.value.trim()) {
          errMsg.classList.remove('hidden');
          msgEl.classList.add('border-rose-500');
          valid = false;
        } else {
          errMsg.classList.add('hidden');
          msgEl.classList.remove('border-rose-500');
        }

        if (valid) {
          form.classList.add('hidden');
